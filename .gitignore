__pycache__/
*.pyc
.venv/
venv/
*.jsonl
.env
docs/plan.md

# Everything in data/ is regenerated by the pipeline, with one exception:
# the LLM explanations are generated offline and committed on purpose, so a
# clone renders them without a model endpoint or an API key. Git cannot
# re-include a file whose parent directory is excluded, hence data/* rather
# than data/.
data/*
!data/explanations.json

# Internal working notes, kept on disk and out of the public repo
docs/BUILD_LOG.md
docs/NEXT.md
